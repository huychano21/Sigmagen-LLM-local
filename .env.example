# SigmaGen Local — Cấu hình mẫu (.env.example)
# Sao chép file này thành .env: cp .env.example .env

# 1. LLM Provider ("ollama" chạy local, hoặc "openai", "anthropic", "local_fallback")
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# 2. Embedding model cho ChromaDB RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
SIGMAGEN_DATA_DIR=

# 3. Cấu hình dải ID và Group cho Wazuh XML Output
RULE_ID_MIN=100100
RULE_ID_MAX=109999
WAZUH_GROUP_WRAPPER=ml_generated,sysmon,

# 4. Trọng số chấm điểm Kiểm chứng 3 Câu hỏi (Vòng A & Vòng B)
WEIGHT_Q1_SYNTAX=0.20
WEIGHT_Q2_DATA_LINKAGE=0.30
WEIGHT_Q3_BEHAVIOR=0.50
QUALITY_GATE_PASS_THRESHOLD=80.0
MAX_REPAIR_RETRIES=2

# 5. Tùy chọn Cloud API (chỉ dùng nếu đổi LLM_PROVIDER sang openai/anthropic)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
