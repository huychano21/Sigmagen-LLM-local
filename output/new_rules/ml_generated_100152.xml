<group name="ml_generated,sysmon,">
  <rule id="100152" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+cmd\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)whoami</field>
    <description>User Account Privilege Enumeration via Command Shell [Alert: AI-20261012_133246.002-af279a390f6e]</description>
    <mitre>
      <id>T1059.003</id>
    </mitre>
  </rule>
</group>