<group name="ml_generated,sysmon,">
  <rule id="100124" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+tasklist\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+cmd\.exe$</field>
    <description>Detect Suspicious cmd.exe spawning tasklist.exe [Alert: AI-20261012_133432.212-ca405139099e]</description>
    <mitre>
      <id>T1087</id>
    </mitre>
  </rule>
</group>