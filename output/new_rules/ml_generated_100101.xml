<group name="ml_generated,sysmon,">
  <rule id="100101" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+systeminfo\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+cmd\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)systeminfo</field>
    <description>Detect Suspicious cmd.exe spawning systeminfo.exe [Alert: AI-20261012_133136.526-4fcd33de388c]</description>
    <mitre>
      <id>T1087</id>
      <id>T1059.003</id>
    </mitre>
  </rule>
</group>