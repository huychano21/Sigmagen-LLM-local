<group name="ml_generated,sysmon,">
  <rule id="100162" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+cmd\.exe$</field>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\+powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)netstat</field>
    <description>Network Connection and Session Enumeration via Command Shell [Alert: AI-20261012_133350.493-6bc753d465b0]</description>
    <mitre>
      <id>T1059.003</id>
    </mitre>
  </rule>
</group>